# Win11Dark - tema oscuro para IceWM inspirado en Windows 11
Theme="Win11Dark"
ThemeDescription="Tema oscuro moderno estilo Windows 11"
ThemeAuthor="Claude"

Look=flat

# ---------- Fuentes ----------
TitleFontNameXft="sans-serif:size=10"
MenuFontNameXft="sans-serif:size=10"
StatusFontNameXft="sans-serif:size=10"
QuickSwitchFontNameXft="sans-serif:size=11"
NormalButtonFontNameXft="sans-serif:size=10"
ActiveButtonFontNameXft="sans-serif:size=10:bold"
NormalTaskBarFontNameXft="sans-serif:size=10"
ActiveTaskBarFontNameXft="sans-serif:size=10"
ToolButtonFontNameXft="sans-serif:size=10"
NormalWorkspaceFontNameXft="sans-serif:size=10"
ActiveWorkspaceFontNameXft="sans-serif:size=10:bold"
MinimizedWindowFontNameXft="sans-serif:size=9"
ListBoxFontNameXft="sans-serif:size=10"
ToolTipFontNameXft="sans-serif:size=10"
ClockFontNameXft="sans-serif:size=10"
ApmFontNameXft="sans-serif:size=10"
InputFontNameXft="sans-serif:size=10"
LabelFontNameXft="sans-serif:size=10"

# ---------- Marcos de ventana ----------
BorderSizeX=1
BorderSizeY=1
DlgBorderSizeX=1
DlgBorderSizeY=1
CornerSizeX=8
CornerSizeY=8
TitleBarHeight=32
TitleBarCentered=0
TitleBarJoinLeft=1
TitleBarJoinRight=1
TitleBarHorzOffset=4
TitleBarVertOffset=0
ShowMenuButtonIcon=1
TitleButtonsLeft="s"
TitleButtonsRight="xmi"
TitleButtonsSupported="smixrt"

ColorActiveBorder="rgb:3A/3A/3A"
ColorNormalBorder="rgb:2C/2C/2C"
ColorDialog="rgb:2B/2B/2B"

ColorActiveTitleBar="rgb:20/20/20"
ColorActiveTitleBarText="rgb:FF/FF/FF"
ColorActiveTitleBarShadow=""
ColorNormalTitleBar="rgb:2C/2C/2C"
ColorNormalTitleBarText="rgb:9D/9D/9D"
ColorNormalTitleBarShadow=""

# ---------- Botones ----------
ColorNormalButton="rgb:2B/2B/2B"
ColorNormalButtonText="rgb:FF/FF/FF"
ColorActiveButton="rgb:3D/3D/3D"
ColorActiveButtonText="rgb:FF/FF/FF"

# ---------- Menus ----------
ColorNormalMenu="rgb:2C/2C/2C"
ColorNormalMenuItemText="rgb:FF/FF/FF"
ColorActiveMenuItem="rgb:3D/3D/3D"
ColorActiveMenuItemText="rgb:FF/FF/FF"
ColorDisabledMenuItemText="rgb:80/80/80"
ColorDisabledMenuItemShadow=""
MenuMouseTracking=1
SubmenuMenuDelay=200
MenuIconSize=20

# ---------- Barra de tareas ----------
SmallIconSize=24
ColorDefaultTaskBar="rgb:1C/1C/1C"
ColorNormalTaskBarApp="rgb:1C/1C/1C"
ColorNormalTaskBarAppText="rgb:E0/E0/E0"
ColorActiveTaskBarApp="rgb:3A/3A/3A"
ColorActiveTaskBarAppText="rgb:FF/FF/FF"
ColorMinimizedTaskBarApp="rgb:1C/1C/1C"
ColorMinimizedTaskBarAppText="rgb:80/80/80"
ColorInvisibleTaskBarApp="rgb:1C/1C/1C"
ColorInvisibleTaskBarAppText="rgb:60/60/60"
ColorToolButton="rgb:1C/1C/1C"
ColorToolButtonText="rgb:FF/FF/FF"
TaskBarClockLeds=0
TaskBarWorkspacesLeft=0

ColorClock="rgb:1C/1C/1C"
ColorClockText="rgb:FF/FF/FF"
ColorApm="rgb:1C/1C/1C"
ColorApmText="rgb:FF/FF/FF"
ColorMailBoxStatus="rgb:1C/1C/1C"

ColorCPUStatusUser="rgb:4C/C2/FF"
ColorCPUStatusSystem="rgb:00/67/C0"
ColorCPUStatusInterrupts="rgb:60/CD/FF"
ColorCPUStatusIoWait="rgb:99/99/99"
ColorCPUStatusIdle="rgb:1C/1C/1C"
ColorCPUStatusNice="rgb:7A/6B/FF"
ColorCPUStatusSoftIrq="rgb:A0/A0/A0"
ColorCPUStatusSteal="rgb:C4/2B/1C"
ColorCPUStatusTemp="rgb:FF/B9/00"

ColorNetSend="rgb:4C/C2/FF"
ColorNetReceive="rgb:60/CD/FF"
ColorNetIdle="rgb:1C/1C/1C"

# ---------- Espacios de trabajo ----------
ColorNormalWorkspaceButton="rgb:1C/1C/1C"
ColorNormalWorkspaceButtonText="rgb:C0/C0/C0"
ColorActiveWorkspaceButton="rgb:00/67/C0"
ColorActiveWorkspaceButtonText="rgb:FF/FF/FF"

# ---------- Listas, entradas, scrollbars ----------
ColorListBox="rgb:2B/2B/2B"
ColorListBoxText="rgb:FF/FF/FF"
ColorListBoxSelection="rgb:00/67/C0"
ColorListBoxSelectionText="rgb:FF/FF/FF"
ColorInput="rgb:1F/1F/1F"
ColorInputText="rgb:FF/FF/FF"
ColorInputSelection="rgb:00/67/C0"
ColorInputSelectionText="rgb:FF/FF/FF"
ColorLabel="rgb:2B/2B/2B"
ColorLabelText="rgb:FF/FF/FF"

ColorScrollBar="rgb:2B/2B/2B"
ColorScrollBarSlider="rgb:6B/6B/6B"
ColorScrollBarButton="rgb:2B/2B/2B"
ColorScrollBarArrow="rgb:C0/C0/C0"
ScrollBarX=14
ScrollBarY=14

# ---------- Tooltips, cambio de ventana, mensajes ----------
ColorToolTip="rgb:2C/2C/2C"
ColorToolTipText="rgb:FF/FF/FF"
ColorQuickSwitch="rgb:2C/2C/2C"
ColorQuickSwitchText="rgb:FF/FF/FF"
ColorQuickSwitchActive="rgb:00/67/C0"
ColorQuickSwitchActiveText="rgb:FF/FF/FF"
ColorMoveSizeStatus="rgb:2C/2C/2C"
ColorMoveSizeStatusText="rgb:FF/FF/FF"

# ---------- Escritorio ----------
DesktopBackgroundColor="rgb:08/0C/1C"
DesktopBackgroundImage="wallpaper.png"
DesktopBackgroundScaled=1
DesktopBackgroundCenter=0
